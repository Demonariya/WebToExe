{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WebToExe Preview",
  "version": "0.1.0",
  "identifier": "com.demonariya.webtoexe.preview",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WebToExe Preview",
        "url": "https://example.com",
        "width": 1280,
        "height": 800,
        "minWidth": 600,
        "minHeight": 400,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
